// ─────────────────────────────────────────────────────────
// FormFit — Prisma Schema (TRD §31–§38)
// ─────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ───────────────────────────────────────────────

enum WorkoutStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

// ── User (TRD §32) ─────────────────────────────────────

model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  passwordHash     String   @map("password_hash")
  fitnessLevel     String?  @map("fitness_level")    // e.g. beginner, intermediate, advanced
  primaryGoal      String?  @map("primary_goal")     // e.g. lose weight, build muscle, improve form
  workoutFrequency String?  @map("workout_frequency") // e.g. 3x/week
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  workouts   Workout[]
  aiCoaching AICoaching[]

  @@map("users")
}

// ── Exercise (TRD §33) ─────────────────────────────────

model Exercise {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  muscleGroup String     @map("muscle_group")
  difficulty  Difficulty @default(BEGINNER)
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")

  workoutSets WorkoutSet[]

  @@map("exercises")
}

// ── Workout (TRD §34) ──────────────────────────────────

model Workout {
  id           String        @id @default(uuid())
  startedAt    DateTime      @default(now()) @map("started_at")
  completedAt  DateTime?     @map("completed_at")
  duration     Int?          // total seconds
  overallScore Float?        @map("overall_score")
  status       WorkoutStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workoutSets WorkoutSet[]
  aiCoaching  AICoaching[]

  @@index([userId])
  @@index([status])
  @@map("workouts")
}

// ── WorkoutSet (TRD §35) ───────────────────────────────

model WorkoutSet {
  id           String   @id @default(uuid())
  setNumber    Int      @map("set_number")
  reps         Int      @default(0)
  averageScore Float?   @map("average_score")
  bestScore    Float?   @map("best_score")
  worstScore   Float?   @map("worst_score")
  duration     Int?     // seconds
  createdAt    DateTime @default(now()) @map("created_at")

  workoutId  String  @map("workout_id")
  workout    Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  exerciseId String   @map("exercise_id")
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  formFeedback FormFeedback[]

  @@index([workoutId])
  @@index([exerciseId])
  @@map("workout_sets")
}

// ── FormFeedback (TRD §36) ─────────────────────────────

model FormFeedback {
  id              String   @id @default(uuid())
  errorType       String   @map("error_type")       // e.g. knee_valgus, insufficient_depth
  severity        Severity @default(MEDIUM)
  occurrenceCount Int      @default(1) @map("occurrence_count")
  createdAt       DateTime @default(now()) @map("created_at")

  setId      String     @map("set_id")
  workoutSet WorkoutSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@index([setId])
  @@index([errorType])
  @@map("form_feedback")
}

// ── AICoaching (TRD §37) ───────────────────────────────

model AICoaching {
  id              String   @id @default(uuid())
  summary         String
  strengths       Json?    // JSON array of strings
  areasToImprove  Json?    @map("areas_to_improve")  // JSON array of strings
  recommendations Json?    // JSON array of strings
  createdAt       DateTime @default(now()) @map("created_at")

  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  workoutId String  @map("workout_id")
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workoutId])
  @@map("ai_coaching")
}
