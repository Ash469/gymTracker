# ──────────────────────────────────────────────
# FormFit Backend — Environment Variables
# ──────────────────────────────────────────────

# Server Configuration
PORT=4000
NODE_ENV=development

# Local PostgreSQL Database (Used when NODE_ENV=development)
LOCAL_DATABASE_URL="postgresql://postgres:pgAdmin@localhost:5432/FormFit?schema=public"

# AWS RDS PostgreSQL Database (Used when NODE_ENV=production)
AWS_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@database-1.c7aukg8qeyx8.ap-south-1.rds.amazonaws.com:5432/postgres?sslmode=require"

# Fallback Database URL
DATABASE_URL="postgresql://postgres:pgAdmin@localhost:5432/FormFit?schema=public"

# JWT Authentication
JWT_SECRET="change-me-to-a-strong-random-secret"
JWT_EXPIRES_IN="7d"

# AWS Bedrock AI Integration
AWS_REGION="us-east-1"
# Option A: Bedrock API Key / Bearer Token
AWS_BEARER_TOKEN_BEDROCK="ABSKQ..."
AWS_BEDROCK_API_KEY="ABSKQ..."

# Option B: IAM Access Keys
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"

# Selected Model ID from your AWS Bedrock Console catalog:
# 1. Claude 3 Haiku (Recommended - Fast & Cost Effective):
#    AWS_BEDROCK_MODEL_ID="anthropic.claude-3-haiku-20240307-v1:0"
# 2. Claude 3.5 Sonnet v2 (High Reasoning Accuracy):
#    AWS_BEDROCK_MODEL_ID="us.anthropic.claude-3-5-sonnet-20241022-v2:0"
# 3. Claude 3.5 Sonnet:
#    AWS_BEDROCK_MODEL_ID="anthropic.claude-3-5-sonnet-20240620-v1:0"
# 4. Claude 3.7 Sonnet:
#    AWS_BEDROCK_MODEL_ID="us.anthropic.claude-3-7-sonnet-20250219-v1:0"
AWS_BEDROCK_MODEL_ID="anthropic.claude-3-haiku-20240307-v1:0"
